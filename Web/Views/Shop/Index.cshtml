@model ShopResultDto
@{
    var filter = Model.Filter;
}

<div class="container" style="padding:20px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;flex-wrap:wrap;gap:12px;">
        <div>
            <h1 style="font-size:22px;font-weight:800;color:var(--dark);margin:0;">
                @(Model.PageTitle ?? "فروشگاه")
            </h1>
            <p style="font-size:12px;color:var(--gray);margin:4px 0 0;">
                @Model.Total محصول یافت شد
            </p>
        </div>
        <div style="display:flex;gap:8px;align-items:center;">
            <label style="font-size:12px;color:var(--gray);">مرتب‌سازی:</label>
            <select onchange="window.location.href='?sort='+this.value+'&search=@filter.Search'"
                    class="form-control" style="min-width:160px;">
                <option value="newest" selected="@(filter.SortBy == ShopSortBy.Newest)">جدیدترین</option>
                <option value="price_asc" selected="@(filter.SortBy == ShopSortBy.PriceAsc)">ارزان‌ترین</option>
                <option value="price_desc" selected="@(filter.SortBy == ShopSortBy.PriceDesc)">گران‌ترین</option>
                <option value="best_selling" selected="@(filter.SortBy == ShopSortBy.BestSelling)">پرفروش‌ترین</option>
                <option value="top_rated" selected="@(filter.SortBy == ShopSortBy.TopRated)">محبوب‌ترین</option>
                <option value="most_viewed" selected="@(filter.SortBy == ShopSortBy.MostViewed)">پربازدیدترین</option>
            </select>
        </div>
    </div>

    @if (!Model.Products.Any())
    {
        <div style="text-align:center;padding:80px 20px;background:#fff;border-radius:12px;">
            <i class="fas fa-search" style="font-size:64px;color:var(--border);"></i>
            <h3 style="margin:16px 0 8px;">محصولی یافت نشد</h3>
            <p style="color:var(--gray);margin-bottom:20px;">فیلترها را تغییر دهید</p>
            <a href="/shop" class="btn btn-primary">نمایش همه</a>
        </div>
    }
    else
    {
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px;">
            @foreach (var p in Model.Products)
            {
                <partial name="~/Views/Home/Partials/_ProductCard.cshtml" model="p" />
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <div style="display:flex;justify-content:center;gap:6px;margin-top:30px;">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <a href="?page=@i&search=@filter.Search&sort=@filter.SortBy.ToString().ToLower()"
                       style="padding:8px 14px;border-radius:6px;text-decoration:none;
                                          font-weight:600;font-size:13px;
                                          background:@(i == Model.Page ? "var(--primary)" : "#fff");
                                          color:@(i == Model.Page ? "#fff" : "#333");
                                          border:1px solid var(--border);">
                        @i
                    </a>
                }
            </div>
        }
    }
</div>