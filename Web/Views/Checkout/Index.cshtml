                    @foreach (var opt in summary.ShippingOptions)
                    {
                        <label style="display:flex;align-items:center;gap:10px;padding:12px;
                                              border:2px solid var(--border);border-radius:10px;
                                              cursor:pointer;margin-bottom:8px;transition:all .2s;"
                               class="ship-option">
                            <input type="radio" name="ShippingMethod" value="@((int)opt.Method)"
                                   checked="@(opt.Method == ShippingMethod.Normal)" />
                            <div style="flex:1;">
                                <div style="font-weight:700;font-size:13px;">@opt.Title</div>
                                <div style="font-size:11px;color:var(--gray);">@opt.Description · @opt.EstimatedDelivery</div>
                            </div>
                            <div style="font-weight:700;color:var(--primary);">
                                @(opt.IsFree ? "رایگان" : opt.Cost.ToString("N0") + " تومان")
                            </div>
                        </label>
                    }
                </div>

                <div class="panel" style="background:#fff;padding:20px;border-radius:12px;">
                    <h3 style="font-size:14px;font-weight:700;margin-bottom:16px;">
                        <i class="fas fa-credit-card" style="color:var(--primary);"></i> روش پرداخت
