@{
    ViewData["Title"] = "پرداخت ناموفق";
}

<div class="container" style="padding:60px 20px;text-align:center;">
    <div style="max-width:600px;margin:0 auto;background:#fff;border-radius:16px;padding:40px;">
        <div style="width:80px;height:80px;border-radius:50%;background:#fdeaea;
                    color:var(--danger);display:flex;align-items:center;
                    justify-content:center;font-size:40px;margin:0 auto 20px;">
            <i class="fas fa-times-circle"></i>
        </div>
        <h1 style="font-size:22px;font-weight:800;color:var(--danger);margin-bottom:8px;">
            پرداخت ناموفق
        </h1>
        @if (ViewBag.Message != null)
        {
            <p style="color:var(--gray);margin-bottom:16px;">@ViewBag.Message</p>
        }
        @if (ViewBag.OrderNumber != null)
        {
            <p style="color:var(--gray);font-size:12px;">شماره سفارش: <strong>@ViewBag.OrderNumber</strong></p>
        }

        <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:24px;">
            <a href="/cart" class="btn btn-primary">
                <i class="fas fa-shopping-cart"></i> بازگشت به سبد خرید
            </a>
            <a href="/" class="btn btn-outline">صفحه اصلی</a>
        </div>
    </div>
</div>