@model Order
@{
    ViewData["Title"] = "سفارش ثبت شد";
}

<div class="container" style="padding:60px 20px;text-align:center;">
    <div style="max-width:600px;margin:0 auto;background:#fff;border-radius:16px;padding:40px;">
        <div style="width:80px;height:80px;border-radius:50%;background:#e8f8f0;
                    color:var(--success);display:flex;align-items:center;
                    justify-content:center;font-size:40px;margin:0 auto 20px;">
            <i class="fas fa-check-circle"></i>
        </div>
        <h1 style="font-size:24px;font-weight:800;color:var(--success);margin-bottom:8px;">
            سفارش شما با موفقیت ثبت شد
        </h1>
        <p style="color:var(--gray);margin-bottom:24px;">ممنون از اعتماد شما</p>

        <div style="background:#f8fafc;border-radius:10px;padding:20px;text-align:right;margin-bottom:24px;">
            <div style="display:flex;justify-content:space-between;margin-bottom:8px;">
                <span style="color:var(--gray);">شماره سفارش:</span>
                <strong>@Model.OrderNumber</strong>
            </div>
            @if (!string.IsNullOrEmpty(Model.PaymentTrackingCode))
            {
                <div style="display:flex;justify-content:space-between;margin-bottom:8px;">
                    <span style="color:var(--gray);">کد پیگیری پرداخت:</span>
                    <strong dir="ltr">@Model.PaymentTrackingCode</strong>
                </div>
            }
            <div style="display:flex;justify-content:space-between;">
                <span style="color:var(--gray);">مبلغ کل:</span>
                <strong style="color:var(--success);">@Model.TotalAmount.ToString("N0") تومان</strong>
            </div>
        </div>

        <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
            <a href="/customer/orders/detail/@Model.Id" class="btn btn-primary">
                <i class="fas fa-eye"></i> مشاهده سفارش
            </a>
            <a href="/" class="btn btn-outline">
                <i class="fas fa-home"></i> بازگشت به فروشگاه
            </a>
        </div>
    </div>
</div>