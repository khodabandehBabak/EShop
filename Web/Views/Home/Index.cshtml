@* @model HomeViewModel
@{
    ViewData["Title"] = "فروشگاه ستارخان";
}

<!-- ═══════════════ HERO SLIDER ═══════════════ -->
@if (Model.HeroSliders.Any())
{
    <div class="container" style="margin-top:20px;">
        <div class="hero-slider" id="heroSlider">
            @foreach (var slide in Model.HeroSliders)
            {
                <div class="hero-slide" style="background-image:url('@slide.ImageUrl');
                                    background-color:@(slide.BgColor ?? "#f1f0f0");">
                    @if (!string.IsNullOrEmpty(slide.ProductImageUrl))
                    {
                        <figure style="position:absolute;left:5%;bottom:0;max-width:40%;max-height:90%;">
                            <img src="@slide.ProductImageUrl" alt="@(slide.Alt ?? slide.Title)"
                                 style="max-width:100%;max-height:100%;object-fit:contain;" />
                        </figure>
                    }
                    <div style="position:relative;z-index:2;height:100%;display:flex;
                                        align-items:center;justify-content:flex-end;padding:60px 5%;">
                        <div style="text-align:right;max-width:520px;color:@(slide.TextColor ?? "#333");">
                            @if (!string.IsNullOrEmpty(slide.Subtitle))
                            {
                                <h5 style="font-size:13px;font-weight:700;letter-spacing:2px;
                                                       text-transform:uppercase;color:var(--primary);margin-bottom:10px;">
                                    @slide.Subtitle
                                </h5>
                            }
                            <h2 style="font-size:40px;font-weight:800;line-height:1.3;margin-bottom:16px;">
                                @slide.Title
                            </h2>
                            @if (!string.IsNullOrEmpty(slide.Description))
                            {
                                <p style="font-size:15px;line-height:1.8;color:#475569;margin-bottom:24px;">
                                    @slide.Description
                                </p>
                            }
                            @if (!string.IsNullOrEmpty(slide.BtnText))
                            {
                                <a href="@(slide.BtnLink ?? "#")"
                                   style="display:inline-flex;align-items:center;gap:8px;
                                                      background:var(--primary);color:#fff;padding:12px 28px;
                                                      border-radius:8px;font-weight:700;font-size:14px;text-decoration:none;">
                                    @slide.BtnText <i class="fas fa-arrow-left"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- ═══════════════ ICON BOXES ═══════════════ -->
<div class="container">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
                gap:16px;margin:30px 0;padding:20px;background:#fff;
                border-radius:12px;border:1px solid var(--border);">
        <div style="display:flex;align-items:center;gap:12px;">
            <div style="width:48px;height:48px;border-radius:12px;background:#e6f4ff;
                        display:flex;align-items:center;justify-content:center;
                        color:var(--primary);font-size:20px;">
                <i class="fas fa-truck"></i>
            </div>
            <div>
                <h4 style="font-size:13px;font-weight:700;margin:0;">ارسال رایگان</h4>
                <p style="font-size:11px;color:var(--gray);margin:0;">
                    بالای @Model.FreeShippingThreshold.ToString("N0") تومان
                </p>
            </div>
        </div>
        <div style="display:flex;align-items:center;gap:12px;">
            <div style="width:48px;height:48px;border-radius:12px;background:#e8f8f0;
                        display:flex;align-items:center;justify-content:center;
                        color:var(--success);font-size:20px;">
                <i class="fas fa-undo"></i>
            </div>
            <div>
                <h4 style="font-size:13px;font-weight:700;margin:0;">بازگشت آسان</h4>
                <p style="font-size:11px;color:var(--gray);margin:0;">تا ۷ روز پس از تحویل</p>
            </div>
        </div>
        <div style="display:flex;align-items:center;gap:12px;">
            <div style="width:48px;height:48px;border-radius:12px;background:#fff3e0;
                        display:flex;align-items:center;justify-content:center;
                        color:var(--warning);font-size:20px;">
                <i class="fas fa-lock"></i>
            </div>
            <div>
                <h4 style="font-size:13px;font-weight:700;margin:0;">پرداخت امن</h4>
                <p style="font-size:11px;color:var(--gray);margin:0;">درگاه زرین‌پال</p>
            </div>
        </div>
        <div style="display:flex;align-items:center;gap:12px;">
            <div style="width:48px;height:48px;border-radius:12px;background:#f3e8ff;
                        display:flex;align-items:center;justify-content:center;
                        color:#8e44ad;font-size:20px;">
                <i class="fas fa-headset"></i>
            </div>
            <div>
                <h4 style="font-size:13px;font-weight:700;margin:0;">پشتیبانی ۲۴/۷</h4>
                <p style="font-size:11px;color:var(--gray);margin:0;">تلفنی یا چت آنلاین</p>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════ DEALS OF THE DAY ═══════════════ -->
@if (Model.DealsOfTheDay.Any())
{
    <div class="container">
        <div class="section-title">
            <h2><i class="fas fa-fire" style="color:var(--danger);"></i> پیشنهاد شگفت‌انگیز امروز</h2>
            <div style="display:flex;align-items:center;gap:16px;">
                <div style="background:#fff3e0;color:var(--warning);padding:5px 14px;
                                border-radius:8px;font-weight:700;font-size:12px;">
                    <i class="fas fa-clock"></i> <span id="dealCountdown">00:00:00</span>
                </div>
                <a href="/shop?discounted=true" class="link-more">مشاهده همه <i class="fas fa-arrow-left"></i></a>
            </div>
        </div>
        <div class="product-carousel">
            @foreach (var p in Model.DealsOfTheDay)
            {
                <partial name="Partials/_ProductCard" model="p" />
            }
        </div>
    </div>
}

<!-- ═══════════════ CATEGORY SHOWCASE ═══════════════ -->
@if (Model.CategoryShowcase.Any())
{
    <div class="container">
        <div class="section-title">
            <h2><i class="fas fa-th-large" style="color:var(--primary);"></i> دسته‌بندی‌های محبوب</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:14px;">
            @foreach (var c in Model.CategoryShowcase)
            {
                <a href="/category/@c.Slug" class="category-tile">
                    <div style="width:60px;height:60px;border-radius:50%;background:#f0f9ff;
                                        display:flex;align-items:center;justify-content:center;
                                        overflow:hidden;">
                        @if (!string.IsNullOrEmpty(c.ImageUrl))
                        {
                            <img src="@c.ImageUrl" alt="@c.Name" style="width:100%;height:100%;object-fit:cover;" />
                        }
                        else
                        {
                            <i class="@(c.Icon ?? "fas fa-box")" style="font-size:24px;color:var(--primary);"></i>
                        }
                    </div>
                    <div style="font-size:12px;font-weight:700;text-align:center;margin-top:8px;">@c.Name</div>
                    <div style="font-size:10px;color:var(--gray);">@c.ProductCount محصول</div>
                </a>
            }
        </div>
    </div>
}

<!-- ═══════════════ TOP SELLING ═══════════════ -->
@if (Model.TopSelling.Any())
{
    <div class="container">
        <partial name="Partials/_ProductGrid"
                 model="@(new ValueTuple<string, List<ProductCardDto>>("پرفروش‌ترین‌ها", Model.TopSelling))" />
    </div>
}

<!-- ═══════════════ MIDDLE BANNER ═══════════════ -->
@if (Model.MiddleBanners.Any())
{
    <div class="container" style="margin:40px 0;">
        @foreach (var banner in Model.MiddleBanners.Take(1))
        {
            <a href="@(banner.BtnLink ?? "#")" style="display:block;border-radius:16px;overflow:hidden;">
                <img src="@banner.ImageUrl" alt="@(banner.Alt ?? banner.Title)"
                     style="width:100%;height:auto;display:block;" />
            </a>
        }
    </div>
}

<!-- ═══════════════ NEWEST ═══════════════ -->
@if (Model.Newest.Any())
{
    <div class="container">
        <partial name="Partials/_ProductGrid"
                 model="@(new ValueTuple<string, List<ProductCardDto>>("جدیدترین محصولات", Model.Newest))" />
    </div>
}

<!-- ═══════════════ FEATURED ═══════════════ -->
@if (Model.Featured.Any())
{
    <div class="container">
        <partial name="Partials/_ProductGrid"
                 model="@(new ValueTuple<string, List<ProductCardDto>>("محصولات ویژه", Model.Featured))" />
    </div>
}

<!-- ═══════════════ TOP RATED ═══════════════ -->
@if (Model.TopRated.Any())
{
    <div class="container">
        <partial name="Partials/_ProductGrid"
                 model="@(new ValueTuple<string, List<ProductCardDto>>("محبوب‌ترین‌ها", Model.TopRated))" />
    </div>
}

<!-- ═══════════════ MOST VIEWED ═══════════════ -->
@if (Model.MostViewed.Any())
{
    <div class="container">
        <partial name="Partials/_ProductGrid"
                 model="@(new ValueTuple<string, List<ProductCardDto>>("پربازدیدترین‌های اخیر", Model.MostViewed))" />
    </div>
}

<!-- ═══════════════ BRANDS ═══════════════ -->
@if (Model.Brands.Any())
{
    <div class="container" style="margin-bottom:60px;">
        <div class="section-title">
            <h2><i class="fas fa-tags" style="color:var(--primary);"></i> برندهای معتبر</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:12px;">
            @foreach (var b in Model.Brands)
            {
                <a href="/brand/@b.Slug" class="brand-tile">
                    @if (!string.IsNullOrEmpty(b.LogoUrl))
                    {
                        <img src="@b.LogoUrl" alt="@b.Name"
                             style="max-height:60px;filter:grayscale(50%);transition:filter .2s;" />
                    }
                    else
                    {
                        <div style="font-weight:800;color:var(--gray);font-size:13px;">@b.Name</div>
                    }
                </a>
            }
        </div>
    </div>
}

@section Styles {
    <style>
        .section-title {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin: 40px 0 24px;
            padding-bottom: 14px;
            border-bottom: 2px solid var(--border);
        }

            .section-title h2 {
                font-size: 20px;
                font-weight: 800;
                margin: 0;
                color: var(--dark);
                display: flex;
                align-items: center;
                gap: 10px;
            }

        .link-more {
            font-size: 12px;
            color: var(--primary);
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .hero-slider {
            position: relative;
            border-radius: 16px;
            overflow: hidden;
            min-height: 480px;
            background: var(--border);
        }

        .hero-slide {
            min-height: 480px;
            background-size: cover;
            background-position: center;
            position: relative;
        }

        .hero-slider {
            display: flex;
            overflow: hidden;
        }

        .hero-slide {
            min-width: 100%;
            transition: transform .5s ease;
        }

        .product-carousel {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 16px;
        }

        .category-tile {
            background: #fff;
            border-radius: 12px;
            padding: 16px 10px;
            border: 1px solid var(--border);
            text-align: center;
            transition: all .2s;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-decoration: none;
            color: inherit;
        }

            .category-tile:hover {
                border-color: var(--primary);
                transform: translateY(-3px);
                box-shadow: 0 8px 20px rgba(0,136,204,.1);
            }

        .brand-tile {
            background: #fff;
            border-radius: 12px;
            padding: 20px;
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100px;
            transition: all .2s;
            text-decoration: none;
        }

            .brand-tile:hover {
                border-color: var(--primary);
            }

        @@media (max-width: 767px) {
            .hero-slider, .hero-slide {
                min-height: 380px;
            }

                .hero-slide h2 {
                    font-size: 26px !important;
                }
        }
    </style>
}

@section Scripts {
    <script>
        // اسلایدر خودکار ساده
        (function() {
            const slides = document.querySelectorAll('.hero-slide');
            if (slides.length < 2) return;
            let i = 0;
            slides.forEach((s, idx) => {
                if (idx > 0) s.style.transform = 'translateX(100%)';
            });
            setInterval(() => {
                slides.forEach((s, idx) => {
                    s.style.transform = `translateX(${(idx - i) * 100}%)`;
                });
                i = (i + 1) % slides.length;
                if (i === 0) {
                    setTimeout(() => {
                        slides.forEach((s, idx) => {
                            s.style.transition = 'none';
                            s.style.transform = `translateX(${idx * 100}%)`;
                        });
                        setTimeout(() => {
                            slides.forEach(s => s.style.transition = '');
                        }, 50);
                    }, 500);
                }
            }, 5000);
        })();

        // شمارش معکوس
        (function() {
            const end = new Date();
            end.setHours(23, 59, 59, 999);
            function tick() {
                const diff = Math.max(0, end - new Date());
                const h = String(Math.floor(diff / 3600000)).padStart(2, '0');
                const m = String(Math.floor(diff % 3600000 / 60000)).padStart(2, '0');
                const s = String(Math.floor(diff % 60000 / 1000)).padStart(2, '0');
                const el = document.getElementById('dealCountdown');
                if (el) el.textContent = `${h}:${m}:${s}`;
            }
            tick(); setInterval(tick, 1000);
        })();
    </script>
} *@

@model HomeViewModel
@{
    ViewData["Title"] = "فروشگاه ستارخان";
}

<div class="container" style="padding-top:16px;">

    <!-- Hero Slider -->
    @if (Model.HeroSliders.Any())
    {
        <div class="hero-slider" id="heroSlider">
            @for (int i = 0; i < Model.HeroSliders.Count; i++)
            {
                var slide = Model.HeroSliders[i];
                <div class="hero-slide @(i == 0 ? "active" : "")"
                     style="background-image:url('@slide.ImageUrl');
                                    background-color:@(slide.BgColor ?? "#f1f0f0");">
                    <div class="hero-slide-content">
                        @if (!string.IsNullOrEmpty(slide.Subtitle))
                        {
                            <div style="font-size:11px;font-weight:700;letter-spacing:2px;
                                                    text-transform:uppercase;opacity:.9;margin-bottom:6px;">
                                @slide.Subtitle
                            </div>
                        }
                        <h2>@slide.Title</h2>
                        @if (!string.IsNullOrEmpty(slide.Description))
                        {
                            <p>@slide.Description</p>
                        }
                        @if (!string.IsNullOrEmpty(slide.BtnText))
                        {
                            <a href="@(slide.BtnLink ?? "#")" class="btn">
                                @slide.BtnText <i class="fas fa-arrow-left"></i>
                            </a>
                        }
                    </div>
                </div>
            }
            @if (Model.HeroSliders.Count > 1)
            {
                <div class="hero-nav">
                    @for (int i = 0; i < Model.HeroSliders.Count; i++)
                    {
                        <button class="hero-dot @(i == 0 ? "active" : "")" data-slide="@i" aria-label="اسلاید @(i + 1)"></button>
                    }
                </div>
            }
        </div>
    }

    <!-- Trust Badges -->
    <div class="trust-badges">
        <div class="trust-badge">
            <div class="trust-badge-icon blue"><i class="fas fa-truck"></i></div>
            <div>
                <div class="trust-badge-title">ارسال رایگان</div>
                <div class="trust-badge-desc">سفارشات بالای @Model.FreeShippingThreshold.ToString("N0")</div>
            </div>
        </div>
        <div class="trust-badge">
            <div class="trust-badge-icon green"><i class="fas fa-undo"></i></div>
            <div>
                <div class="trust-badge-title">بازگشت آسان</div>
                <div class="trust-badge-desc">تا ۷ روز پس از تحویل</div>
            </div>
        </div>
        <div class="trust-badge">
            <div class="trust-badge-icon orange"><i class="fas fa-lock"></i></div>
            <div>
                <div class="trust-badge-title">پرداخت امن</div>
                <div class="trust-badge-desc">درگاه رمزنگاری‌شده</div>
            </div>
        </div>
        <div class="trust-badge">
            <div class="trust-badge-icon red"><i class="fas fa-headset"></i></div>
            <div>
                <div class="trust-badge-title">پشتیبانی ۲۴/۷</div>
                <div class="trust-badge-desc">تلفنی یا چت آنلاین</div>
            </div>
        </div>
    </div>

    <!-- Categories -->
    @if (Model.CategoryShowcase.Any())
    {
        <section class="section">
            <div class="section-title">
                <h2>دسته‌بندی‌های محبوب</h2>
            </div>
            <div class="categories-grid">
                @foreach (var cat in Model.CategoryShowcase)
                {
                    <a href="/category/@cat.Slug" class="category-tile">
                        <div class="category-tile-icon">
                            @if (!string.IsNullOrEmpty(cat.ImageUrl))
                            {
                                <img src="@cat.ImageUrl" alt="@cat.Name" />
                            }
                            else
                            {
                                <i class="@(cat.Icon ?? "fas fa-box")"></i>
                            }
                        </div>
                        <div class="category-tile-name">@cat.Name</div>
                        <div class="category-tile-count">@cat.ProductCount</div>
                    </a>
                }
            </div>
        </section>
    }

    <!-- Deals of the Day -->
    @if (Model.DealsOfTheDay.Any())
    {
        <section class="section">
            <div class="section-title">
                <h2><i class="fas fa-fire" style="color:var(--danger);"></i> پیشنهاد شگفت‌انگیز</h2>
                <div style="background:var(--accent-light);color:#92400e;padding:4px 12px;
                                border-radius:var(--r-full);font-weight:700;font-size:12px;">
                    <i class="fas fa-clock"></i> <span id="dealCountdown">--:--:--</span>
                </div>
            </div>
            <div class="products-grid">
                @foreach (var p in Model.DealsOfTheDay.Take(5))
                {
                    <partial name="~/Views/Home/Partials/_ProductCard.cshtml" model="p" />
                }
            </div>
        </section>
    }

    <!-- Top Selling -->
    @if (Model.TopSelling.Any())
    {
        <section class="section">
            <div class="section-title">
                <h2>پرفروش‌ترین‌ها</h2>
                <a href="/shop?sort=best_selling">مشاهده همه <i class="fas fa-arrow-left"></i></a>
            </div>
            <div class="products-grid">
                @foreach (var p in Model.TopSelling.Take(5))
                {
                    <partial name="~/Views/Home/Partials/_ProductCard.cshtml" model="p" />
                }
            </div>
        </section>
    }

    <!-- Middle Banner -->
    @if (Model.MiddleBanners.Any())
    {
        var banner = Model.MiddleBanners.First();
        <section class="section">
            <a href="@(banner.BtnLink ?? "#")"
               style="display:block;border-radius:var(--r-lg);overflow:hidden;">
                <img src="@banner.ImageUrl" alt="@(banner.Alt ?? banner.Title)"
                     style="width:100%;height:auto;display:block;" loading="lazy" />
            </a>
        </section>
    }

    <!-- Newest -->
    @if (Model.Newest.Any())
    {
        <section class="section">
            <div class="section-title">
                <h2>جدیدترین محصولات</h2>
                <a href="/shop?sort=newest">مشاهده همه <i class="fas fa-arrow-left"></i></a>
            </div>
            <div class="products-grid">
                @foreach (var p in Model.Newest.Take(5))
                {
                    <partial name="~/Views/Home/Partials/_ProductCard.cshtml" model="p" />
                }
            </div>
        </section>
    }

    <!-- Featured -->
    @if (Model.Featured.Any())
    {
        <section class="section">
            <div class="section-title">
                <h2>محصولات ویژه</h2>
                <a href="/shop">مشاهده همه <i class="fas fa-arrow-left"></i></a>
            </div>
            <div class="products-grid">
                @foreach (var p in Model.Featured.Take(5))
                {
                    <partial name="~/Views/Home/Partials/_ProductCard.cshtml" model="p" />
                }
            </div>
        </section>
    }

    <!-- Most Viewed -->
    @if (Model.MostViewed.Any())
    {
        <section class="section">
            <div class="section-title">
                <h2>پربازدیدترین‌ها</h2>
                <a href="/shop?sort=most_viewed">مشاهده همه <i class="fas fa-arrow-left"></i></a>
            </div>
            <div class="products-grid">
                @foreach (var p in Model.MostViewed.Take(5))
                {
                    <partial name="~/Views/Home/Partials/_ProductCard.cshtml" model="p" />
                }
            </div>
        </section>
    }

    <!-- Brands -->
    @if (Model.Brands.Any())
    {
        <section class="section">
            <div class="section-title">
                <h2>برندهای معتبر</h2>
            </div>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:10px;">
                @foreach (var b in Model.Brands)
                {
                    <a href="/brand/@b.Slug"
                       style="display:flex;align-items:center;justify-content:center;
                                      height:80px;background:var(--surface);border:1px solid var(--border);
                                      border-radius:var(--r);padding:14px;transition:all .2s;"
                       onmouseover="this.style.borderColor='var(--primary)'"
                       onmouseout="this.style.borderColor='var(--border)'">
                        @if (!string.IsNullOrEmpty(b.LogoUrl))
                        {
                            <img src="@b.LogoUrl" alt="@b.Name"
                                 style="max-width:100%;max-height:100%;object-fit:contain;
                                                    filter:grayscale(50%);transition:filter .2s;"
                                 onmouseover="this.style.filter='grayscale(0)'"
                                 onmouseout="this.style.filter='grayscale(50%)'"
                                 loading="lazy" />
                        }
                        else
                        {
                            <div style="font-weight:800;color:var(--text-3);font-size:13px;">@b.Name</div>
                        }
                    </a>
                }
            </div>
        </section>
    }

</div>

@section Scripts {
    <script>
        // Hero slider
        (function () {
            const slides = document.querySelectorAll('.hero-slide');
            const dots = document.querySelectorAll('.hero-dot');
            if (slides.length < 2) return;
            let current = 0;
            let timer;

            function go(idx) {
                slides.forEach((s, i) => s.classList.toggle('active', i === idx));
                dots.forEach((d, i) => d.classList.toggle('active', i === idx));
                current = idx;
            }

            function next() { go((current + 1) % slides.length); }

            dots.forEach(d => d.addEventListener('click', () => {
                go(parseInt(d.dataset.slide));
                resetTimer();
            }));

            function resetTimer() {
                clearInterval(timer);
                timer = setInterval(next, 5000);
            }

            timer = setInterval(next, 5000);
        })();

        // Deals countdown
        (function () {
            const el = document.getElementById('dealCountdown');
            if (!el) return;
            const end = new Date();
            end.setHours(23, 59, 59, 999);

            function tick() {
                const diff = Math.max(0, end - new Date());
                const h = String(Math.floor(diff / 3600000)).padStart(2, '0');
                const m = String(Math.floor(diff % 3600000 / 60000)).padStart(2, '0');
                const s = String(Math.floor(diff % 60000 / 1000)).padStart(2, '0');
                el.textContent = `${h}:${m}:${s}`;
            }
            tick();
            setInterval(tick, 1000);
        })();
    </script>
}