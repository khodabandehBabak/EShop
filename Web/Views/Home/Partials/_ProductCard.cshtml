@model ProductCardDto

<div class="product-card">
    <a href="/product/@Model.Slug" class="product-card-media">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Name" class="product-card-img" loading="lazy" />
        }
        else
        {
            <div class="product-card-placeholder"><i class="fas fa-image"></i></div>
        }

        @if (!string.IsNullOrEmpty(Model.HoverImageUrl))
        {
            <img src="@Model.HoverImageUrl" alt="@Model.Name" class="product-card-img hover" loading="lazy" />
        }

        <div class="product-badges">
            @if (Model.DiscountPercent > 0)
            {
                <span class="badge badge-solid-danger">-@Model.DiscountPercent%</span>
            }
            @if (Model.IsNew)
            {
                <span class="badge badge-success">جدید</span>
            }
            @if (Model.Stock == 0)
            {
                <span class="badge badge-warning">ناموجود</span>
            }
        </div>
    </a>

    <div class="product-quick-actions">
        <button type="button" class="icon-btn" onclick="addToCartCard(@Model.Id, this)" title="افزودن به سبد">
            <i class="fas fa-shopping-bag"></i>
        </button>
        <button type="button" class="icon-btn" onclick="toggleWishlist(@Model.Id, this)" title="علاقه‌مندی">
            <i class="far fa-heart"></i>
        </button>
    </div>

    <div class="product-card-body">
        <div class="product-category-label">@(Model.BrandName ?? Model.CategoryName)</div>
        <a href="/product/@Model.Slug" class="product-card-title">@Model.Name</a>

        @if (Model.ReviewCount > 0)
        {
            <div class="product-rating">
                <i class="fas fa-star"></i>
                <span>@(Model.Rating?.ToString("0.0") ?? "0")</span>
                <span>(@Model.ReviewCount)</span>
            </div>
        }

        <div class="product-card-price">
            <div>
                @if (Model.DiscountPrice.HasValue)
                {
                    <div class="price-current">
                        @Model.DiscountPrice.Value.ToString("N0") <small>تومان</small>
                    </div>
                    <div class="price-old">@Model.Price.ToString("N0")</div>
                }
                else
                {
                    <div class="price-current">
                        @Model.Price.ToString("N0") <small>تومان</small>
                    </div>
                }
            </div>

            @if (Model.Stock > 0)
            {
                <button class="product-add-btn" onclick="addToCartCard(@Model.Id, this)" aria-label="افزودن به سبد">
                    <i class="fas fa-plus"></i>
                </button>
            }
        </div>
    </div>
</div>

<script>
    async function addToCartCard(productId, btn) {
        btn.disabled = true;
        const original = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const fd = new FormData();
            fd.append('productId', productId);
            fd.append('quantity', 1);
            fd.append('__RequestVerificationToken', token);

            const res = await fetch('/cart/add', { method: 'POST', body: fd }).then(r => r.json());
            if (res.success) {
                showToast('به سبد اضافه شد', 'success');
                document.querySelectorAll('.cart-badge').forEach(b => {
                    b.textContent = res.count;
                    b.style.display = res.count > 0 ? 'flex' : 'none';
                });
            } else {
                showToast(res.message || 'خطا', 'error');
            }
        } catch {
            showToast('خطا در ارتباط با سرور', 'error');
        } finally {
            btn.disabled = false;
            btn.innerHTML = original;
        }
    }

    async function toggleWishlist(productId, btn) {
        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const fd = new FormData();
            fd.append('productId', productId);
            fd.append('__RequestVerificationToken', token);

            const res = await fetch('/customer/wishlist/toggle', { method: 'POST', body: fd })
                .then(r => r.json());
            if (res.success) {
                btn.innerHTML = res.added
                    ? '<i class="fas fa-heart" style="color:var(--danger)"></i>'
                    : '<i class="far fa-heart"></i>';
                showToast(res.message || 'انجام شد', 'success');
            } else {
                showToast(res.message || 'ابتدا وارد شوید', 'error');
            }
        } catch {
            showToast('خطا', 'error');
        }
    }
</script>