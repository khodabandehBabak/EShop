@{
    ViewData["Title"] = "ورود مدیران";
}

<div class="container" style="padding:60px 20px;">
    <div style="max-width:400px;margin:0 auto;background:#fff;border-radius:16px;padding:32px;">
        <div style="text-align:center;margin-bottom:24px;">
            <div style="width:64px;height:64px;border-radius:50%;background:#f3e8ff;
                        color:#8e44ad;display:flex;align-items:center;
                        justify-content:center;font-size:28px;margin:0 auto 12px;">
                <i class="fas fa-shield-alt"></i>
            </div>
            <h1 style="font-size:20px;font-weight:800;">ورود مدیران</h1>
        </div>

        <form method="post" action="/account/adminlogin">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <div style="margin-bottom:12px;">
                <label class="form-label">نام کاربری یا ایمیل</label>
                <input type="text" name="username" class="form-control" dir="ltr" required />
            </div>
            <div style="margin-bottom:20px;">
                <label class="form-label">رمز عبور</label>
                <input type="password" name="password" class="form-control" dir="ltr" required />
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;height:48px;">
                <i class="fas fa-sign-in-alt"></i> ورود
            </button>
        </form>

        <div style="text-align:center;margin-top:16px;">
            <a href="/account/login" style="font-size:12px;color:var(--gray);">
                ورود مشتریان →
            </a>
        </div>
    </div>
</div>