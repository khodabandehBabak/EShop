@{
    ViewData["Title"] = "تأیید کد ورود";
}

<div class="container" style="padding:60px 20px;">
    <div style="max-width:400px;margin:0 auto;background:#fff;border-radius:16px;padding:32px;">
        <div style="text-align:center;margin-bottom:24px;">
            <div style="width:64px;height:64px;border-radius:50%;background:#e8f8f0;
                        color:var(--success);display:flex;align-items:center;
                        justify-content:center;font-size:28px;margin:0 auto 12px;">
                <i class="fas fa-sms"></i>
            </div>
            <h1 style="font-size:20px;font-weight:800;margin-bottom:6px;">کد ارسال‌شده را وارد کنید</h1>
            <p style="color:var(--gray);font-size:12px;">کد ۶ رقمی به <strong>@ViewBag.Phone</strong> ارسال شد</p>
        </div>

        <form method="post" action="/account/verifyotp">
            @Html.AntiForgeryToken()
            <input type="hidden" name="phone" value="@ViewBag.Phone" />
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <div style="margin-bottom:16px;">
                <input type="text" name="code" placeholder="------" maxlength="6"
                       class="form-control" dir="ltr" required
                       style="height:56px;font-size:24px;text-align:center;letter-spacing:8px;font-weight:800;" />
            </div>
            <button type="submit" class="btn btn-primary"
                    style="width:100%;height:48px;font-size:14px;">
                <i class="fas fa-check"></i> تأیید و ورود
            </button>
        </form>

        <div style="text-align:center;margin-top:16px;">
            <a href="/account/login" style="font-size:12px;color:var(--gray);">
                شماره دیگری وارد کنم
            </a>
        </div>
    </div>
</div>