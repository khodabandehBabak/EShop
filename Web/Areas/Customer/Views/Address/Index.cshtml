@model List<Address>
@{
    ViewData["Title"] = "آدرس‌های من";
}

<div style="display:grid;grid-template-columns:2fr 1fr;gap:20px;">
    <div class="panel">
        <div class="panel-title"><i class="fas fa-map-marker-alt"></i> آدرس‌ها (@Model.Count)</div>
        @if (!Model.Any())
        {
            <p style="text-align:center;padding:30px;color:var(--gray);">آدرسی ثبت نکرده‌اید</p>
        }
        else
        {
            foreach (var a in Model)
            {
                <div style="border:1px solid var(--border);border-radius:10px;padding:14px;margin-bottom:10px;position:relative;">
                    <div style="font-weight:700;margin-bottom:4px;">@a.ReceiverName - @a.Phone</div>
                    <div style="font-size:12px;color:var(--gray);line-height:1.9;">
                        @a.Province، @a.City، @a.FullAddress<br />کد پستی: @a.PostalCode
                    </div>
                    <form asp-action="Delete" asp-route-id="@a.Id" method="post" style="position:absolute;top:10px;left:10px;"
                          onsubmit="return confirm('حذف شود؟');">
                        @Html.AntiForgeryToken()
                        <button type="submit" style="background:#fdeaea;color:var(--danger);border:none;padding:4px 10px;border-radius:6px;cursor:pointer;font-size:11px;">
                            <i class="fas fa-times"></i>
                        </button>
                    </form>
                </div>
            }
        }
    </div>

    <div class="panel">
        <div class="panel-title"><i class="fas fa-plus"></i> آدرس جدید</div>
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div style="margin-bottom:10px;">
                <div class="form-label">نام گیرنده</div>
                <input name="ReceiverName" class="form-control" required />
            </div>
            <div style="margin-bottom:10px;">
                <div class="form-label">تلفن</div>
                <input name="Phone" class="form-control" dir="ltr" maxlength="11" required />
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px;">
                <div><div class="form-label">استان</div><input name="Province" class="form-control" required /></div>
                <div><div class="form-label">شهر</div><input name="City" class="form-control" required /></div>
            </div>
            <div style="margin-bottom:10px;">
                <div class="form-label">کد پستی</div>
                <input name="PostalCode" class="form-control" dir="ltr" maxlength="10" required />
            </div>
            <div style="margin-bottom:12px;">
                <div class="form-label">آدرس کامل</div>
                <textarea name="FullAddress" class="form-control" rows="2" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;">
                <i class="fas fa-plus"></i> افزودن
            </button>
        </form>
    </div>
</div>