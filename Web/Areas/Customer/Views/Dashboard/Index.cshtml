@model AppUser
@{
    ViewData["Title"] = "داشبورد";
}

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-bottom:20px;">
    <a href="/customer/orders" class="stat-card">
        <div class="icon" style="background:#e6f4ff;color:var(--primary);"><i class="fas fa-shopping-bag"></i></div>
        <div>
            <div class="num">@ViewBag.TotalOrders</div>
            <div class="label">کل سفارش‌ها</div>
        </div>
    </a>
    <a href="/customer/orders?status=processing" class="stat-card">
        <div class="icon" style="background:#fff3e0;color:var(--warning);"><i class="fas fa-clock"></i></div>
        <div>
            <div class="num">@ViewBag.PendingOrders</div>
            <div class="label">در جریان</div>
        </div>
    </a>
    <a href="/customer/orders?status=delivered" class="stat-card">
        <div class="icon" style="background:#e8f8f0;color:var(--success);"><i class="fas fa-check"></i></div>
        <div>
            <div class="num">@ViewBag.DeliveredOrders</div>
            <div class="label">تحویل شده</div>
        </div>
    </a>
    <a href="/customer/wishlist" class="stat-card">
        <div class="icon" style="background:#fdeaea;color:var(--danger);"><i class="fas fa-heart"></i></div>
        <div>
            <div class="num">@ViewBag.WishlistCount</div>
            <div class="label">علاقه‌مندی</div>
        </div>
    </a>
</div>

<div style="display:grid;grid-template-columns:2fr 1fr;gap:16px;">
    <div class="panel">
        <div class="panel-title">
            <i class="fas fa-shopping-bag" style="color:var(--primary);"></i>
            آخرین سفارش‌ها
        </div>
        @{
            var recent = ViewBag.RecentOrders as List<Order> ?? new();
        }
        @if (!recent.Any())
        {
            <div style="text-align:center;padding:40px 20px;color:var(--gray);">
                <i class="fas fa-box-open" style="font-size:48px;opacity:.3;"></i>
                <p style="margin-top:12px;">هنوز سفارشی ثبت نکرده‌اید</p>
                <a href="/" class="btn btn-primary" style="margin-top:12px;">شروع خرید</a>
            </div>
        }
        else
        {
            <div style="overflow-x:auto;">
                <table style="width:100%;">
                    <thead>
                        <tr style="border-bottom:2px solid var(--border);">
                            <th style="padding:10px 8px;text-align:right;font-size:12px;color:var(--gray);">شماره</th>
                            <th style="padding:10px 8px;text-align:right;font-size:12px;color:var(--gray);">تاریخ</th>
                            <th style="padding:10px 8px;text-align:right;font-size:12px;color:var(--gray);">مبلغ</th>
                            <th style="padding:10px 8px;text-align:right;font-size:12px;color:var(--gray);">وضعیت</th>
                            <th style="padding:10px 8px;text-align:center;font-size:12px;color:var(--gray);">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in recent)
                        {
                            <tr style="border-bottom:1px solid var(--border);">
                                <td style="padding:10px 8px;font-weight:600;">@o.OrderNumber</td>
                                <td style="padding:10px 8px;font-size:12px;color:var(--gray);">
                                    @o.CreatedAt.ToString("yyyy/MM/dd")
                                </td>
                                <td style="padding:10px 8px;font-weight:600;">
                                    @o.TotalAmount.ToString("N0")
                                </td>
                                <td style="padding:10px 8px;">
                                    <span class="status-badge status-@o.Status.ToString().ToLower()">
                                        @GetStatusLabel(o.Status)
                                    </span>
                                </td>
                                <td style="padding:10px 8px;text-align:center;">
                                    <a asp-area="Customer" asp-controller="Orders" asp-action="Detail" asp-route-id="@o.Id"
                                       style="color:var(--primary);font-size:12px;font-weight:600;">
                                        مشاهده
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div>
        <div class="panel">
            <div class="panel-title">
                <i class="fas fa-user" style="color:var(--primary);"></i>
                خلاصه حساب
            </div>
            <div style="margin-bottom:14px;">
                <div style="font-size:11px;color:var(--gray);">جمع خرید موفق</div>
                <div style="font-size:20px;font-weight:800;color:var(--success);">
                    @(((decimal)ViewBag.TotalSpent).ToString("N0")) تومان
                </div>
            </div>
            <div style="padding-top:14px;border-top:1px solid var(--border);
                        font-size:12px;color:var(--gray);line-height:2;">
                <div><strong>نظرات:</strong> @ViewBag.TotalReviews (تأیید: @ViewBag.ApprovedReviews، در انتظار: @ViewBag.PendingReviews)</div>
            </div>
        </div>

        <div class="panel" style="background:linear-gradient(135deg,var(--primary),#00a0f0);color:#fff;">
            <div style="font-size:13px;font-weight:600;margin-bottom:8px;">💡 پیشنهاد ویژه</div>
            <p style="font-size:12px;line-height:1.8;opacity:.95;margin-bottom:12px;">
                با خرید بالای ۲ میلیون تومان، ارسال رایگان!
            </p>
            <a href="/shop" style="display:inline-block;background:#fff;color:var(--primary);
                    padding:8px 20px;border-radius:6px;font-weight:700;font-size:12px;text-decoration:none;">
                مشاهده محصولات
            </a>
        </div>
    </div>
</div>

@functions {
    string GetStatusLabel(OrderStatus s) => s switch
    {
        OrderStatus.Pending => "در انتظار پرداخت",
        OrderStatus.Paid => "پرداخت شده",
        OrderStatus.Processing => "در پردازش",
        OrderStatus.Packed => "بسته‌بندی",
        OrderStatus.Shipped => "ارسال شده",
        OrderStatus.Delivered => "تحویل شده",
        OrderStatus.Cancelled => "لغو شده",
        _ => s.ToString()
    };
}