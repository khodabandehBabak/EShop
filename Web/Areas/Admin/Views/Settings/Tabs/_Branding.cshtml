@model BrandingSettingsDto

<form asp-action="SaveBranding" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-bottom:16px;">
        <div>
            <div class="form-label">لوگوی اصلی</div>
            @if (!string.IsNullOrEmpty(Model.ExistingLogoUrl))
            {
                <img src="@Model.ExistingLogoUrl" style="max-height:80px;background:var(--light);
                                    padding:8px;border-radius:8px;display:block;margin-bottom:8px;" />
            }
            <input type="file" asp-for="LogoFile" accept="image/*"
                   style="width:100%;font-size:11px;" />
        </div>
        <div>
            <div class="form-label">لوگوی فوتر</div>
            @if (!string.IsNullOrEmpty(Model.ExistingFooterLogoUrl))
            {
                <img src="@Model.ExistingFooterLogoUrl" style="max-height:80px;background:var(--light);
                                    padding:8px;border-radius:8px;display:block;margin-bottom:8px;" />
            }
            <input type="file" asp-for="FooterLogoFile" accept="image/*"
                   style="width:100%;font-size:11px;" />
        </div>
        <div>
            <div class="form-label">فاوآیکون</div>
            @if (!string.IsNullOrEmpty(Model.ExistingFaviconUrl))
            {
                <img src="@Model.ExistingFaviconUrl" style="max-height:60px;background:var(--light);
                                    padding:8px;border-radius:8px;display:block;margin-bottom:8px;" />
            }
            <input type="file" asp-for="FaviconFile" accept="image/*"
                   style="width:100%;font-size:11px;" />
        </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px;">
        <div>
            <div class="form-label">عرض لوگو (px)</div>
            <input asp-for="LogoWidth" type="number" class="form-control" min="20" max="500" />
        </div>
        <div>
            <div class="form-label">ارتفاع لوگو (px)</div>
            <input asp-for="LogoHeight" type="number" class="form-control" min="20" max="500" />
        </div>
    </div>

    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> ذخیره</button>
</form>