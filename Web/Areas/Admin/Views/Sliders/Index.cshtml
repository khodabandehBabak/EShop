@model List<SliderListItemDto>
@{
    ViewData["Title"] = "مدیریت اسلایدرها";
}

<div class="panel">
    <div style="display:flex;justify-content:space-between;margin-bottom:16px;">
        <h2 style="font-size:15px;font-weight:700;">اسلایدرها (@Model.Count)</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> اسلایدر جدید</a>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px;">
        @foreach (var s in Model)
        {
            <div id="card-@s.Id" style="border:1px solid var(--border);border-radius:12px;overflow:hidden;background:#fff;">
                <div style="height:130px;background:var(--light);position:relative;">
                    <img src="@s.ImageUrl" style="width:100%;height:100%;object-fit:cover;" />
                    <button onclick="toggle(@s.Id, this)" data-active="@s.IsActive.ToString().ToLower()"
                            style="position:absolute;top:8px;left:8px;background:@(s.IsActive ? "var(--success)" : "var(--gray)");
                                       color:#fff;border:none;padding:3px 10px;border-radius:8px;font-size:10px;font-weight:600;cursor:pointer;">
                        @(s.IsActive ? "✓" : "✗")
                    </button>
                </div>
                <div style="padding:12px;">
                    <div style="font-weight:700;font-size:13px;margin-bottom:4px;">@s.Title</div>
                    <div style="font-size:11px;color:var(--gray);">ترتیب: @s.DisplayOrder</div>
                    <div style="display:flex;gap:4px;margin-top:10px;">
                        <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-primary btn-sm" style="flex:1;">ویرایش</a>
                        <button onclick="del(@s.Id)" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function toggle(id, btn) {
            fetch('/admin/sliders/toggleactive/' + id, { method: 'POST',
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() || '' }
            }).then(r => r.json()).then(res => {
                if (res.success) {
                    btn.textContent = res.isActive ? '✓' : '✗';
                    btn.style.background = res.isActive ? 'var(--success)' : 'var(--gray)';
                }
            });
        }
        function del(id) {
            if (!confirm('حذف شود؟')) return;
            fetch('/admin/sliders/delete/' + id, { method: 'POST',
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() || '' }
            }).then(r => r.json()).then(res => {
                if (res.success) { document.getElementById('card-' + id)?.remove(); showToast(res.message); }
            });
        }
    </script>
}