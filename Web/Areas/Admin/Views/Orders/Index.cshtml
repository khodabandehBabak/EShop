@model List<OrderAdminListItemDto>
@{
    ViewData["Title"] = "مدیریت سفارشات";
    var filter = ViewBag.Filter as OrderAdminFilterDto;
    int page = filter?.Page ?? 1;
    int totalPages = (int)ViewBag.TotalPages;
}

<div class="panel">
    <form method="get" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;">
        <input name="search" value="@filter?.Search" placeholder="شماره سفارش، نام، تلفن، کد رهگیری..."
               class="form-control" style="flex:1;min-width:220px;" />
        <select name="status" class="form-select" style="min-width:150px;">
            <option value="">همه وضعیت‌ها</option>
            @foreach (OrderStatus s in Enum.GetValues<OrderStatus>())
            {
                <option value="@s" selected="@(filter?.Status == s)">@GetStatusLabel(s)</option>
            }
        </select>
        <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> جستجو</button>
    </form>

    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;flex-wrap:wrap;gap:12px;">
        <h2 style="font-size:15px;font-weight:700;color:var(--dark);">
            سفارشات (@ViewBag.Total)
            @if ((int)ViewBag.PendingCount > 0)
            {
                <span style="background:#fff3e0;color:var(--warning);padding:3px 10px;
                                 border-radius:10px;font-size:11px;margin-right:8px;">
                    @ViewBag.PendingCount در انتظار
                </span>
            }
        </h2>
        <div style="display:flex;gap:6px;">
            <button onclick="bulkAction('pack')" id="bulkPackBtn"
                    class="btn btn-warning btn-sm" style="display:none;">
                <i class="fas fa-box"></i> بسته‌بندی انتخاب‌شده
            </button>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div style="text-align:center;padding:50px;color:var(--gray);">
            <i class="fas fa-inbox" style="font-size:60px;opacity:.3;"></i>
            <p style="margin-top:12px;">سفارشی یافت نشد</p>
        </div>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="width:32px;"><input type="checkbox" id="selectAll" onchange="toggleAll(this)" /></th>
                        <th>شماره</th>
                        <th>مشتری</th>
                        <th>مبلغ</th>
                        <th>وضعیت</th>
                        <th>ارسال</th>
                        <th>تاریخ</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model)
                    {
                        <tr>
                            <td><input type="checkbox" class="row-check" value="@o.Id" onchange="updateBulk()" /></td>
                            <td style="font-weight:700;color:var(--primary);">@o.OrderNumber</td>
                            <td>
                                <div style="font-weight:600;">@o.ReceiverName</div>
                                <div style="font-size:11px;color:var(--gray);">@o.ReceiverPhone</div>
                            </td>
                            <td style="font-weight:700;color:var(--success);">
                                @o.TotalAmount.ToString("N0")
                            </td>
                            <td>
                                <span class="status-badge status-@o.Status.ToString().ToLower()">
                                    @o.StatusLabel
                                </span>
                            </td>
                            <td style="font-size:11px;color:var(--gray);">
                                @if (!string.IsNullOrEmpty(o.TrackingNumber))
                                {
                                    <div style="font-weight:600;">@o.ShippingCompany</div>
                                    <div dir="ltr" style="font-family:monospace;">@o.TrackingNumber</div>
                                }
                                else
                                {

                                    <span>—</span>
                                }
                            </td>
                            <td style="font-size:11px;color:var(--gray);">
                                @o.CreatedAt.ToString("MM/dd HH:mm")
                            </td>
                            <td>
                                <a asp-action="Detail" asp-route-id="@o.Id" class="btn btn-primary btn-sm">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div style="display:flex;justify-content:center;gap:6px;margin-top:20px;">
                @for (int i = 1; i <= totalPages; i++)
                {
                    <a href="?page=@i&status=@filter?.Status&search=@filter?.Search"
                       style="padding:8px 14px;border-radius:6px;
                                          text-decoration:none;font-weight:600;font-size:13px;
                                          background:@(i == page ? "var(--primary)" : "var(--light)");
                                          color:@(i == page ? "#fff" : "#333");">
                        @i
                    </a>
                }
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        function getToken() {
            return $('input[name="__RequestVerificationToken"]').val() || '';
        }
        function toggleAll(cb) {
            document.querySelectorAll('.row-check').forEach(x => x.checked = cb.checked);
            updateBulk();
        }
        function updateBulk() {
            const any = document.querySelectorAll('.row-check:checked').length > 0;
            document.getElementById('bulkPackBtn').style.display = any ? 'inline-flex' : 'none';
        }
        async function bulkAction(type) {
            const ids = Array.from(document.querySelectorAll('.row-check:checked'))
                .map(x => parseInt(x.value));
            if (!ids.length) return;
            const fd = new FormData();
            ids.forEach(id => fd.append('ids', id));
            fd.append('__RequestVerificationToken', getToken());
            const res = await fetch('/admin/orders/bulkpack', { method: 'POST', body: fd })
                .then(r => r.json());
            showToast(res.message, res.success ? 'success' : 'error');
            if (res.success) setTimeout(() => location.reload(), 800);
        }
    </script>
}

@functions {
    string GetStatusLabel(OrderStatus s) => s switch
    {
        OrderStatus.Pending => "در انتظار",
        OrderStatus.Paid => "پرداخت شده",
        OrderStatus.Processing => "در پردازش",
        OrderStatus.Packed => "بسته‌بندی",
        OrderStatus.Shipped => "ارسال شده",
        OrderStatus.Delivered => "تحویل",
        OrderStatus.Cancelled => "لغو شده",
        _ => s.ToString()
    };
}