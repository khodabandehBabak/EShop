@model List<BrandListItemDto>
@{
    ViewData["Title"] = "مدیریت برندها";
}

<div class="panel">
    <div style="display:flex;justify-content:space-between;margin-bottom:16px;">
        <h2 style="font-size:15px;font-weight:700;">برندها (@Model.Count)</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> برند جدید</a>
    </div>

    @if (!Model.Any())
    {
        <p style="text-align:center;padding:40px;color:var(--gray);">برندی یافت نشد</p>
    }
    else
    {
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px;">
            @foreach (var b in Model)
            {
                <div id="card-@b.Id" style="border:1px solid var(--border);border-radius:12px;padding:14px;background:#fff;">
                    <div style="height:70px;display:flex;align-items:center;justify-content:center;margin-bottom:10px;">
                        @if (!string.IsNullOrEmpty(b.LogoUrl))
                        {
                            <img src="@b.LogoUrl" style="max-height:70px;max-width:100%;object-fit:contain;" />
                        }
                        else
                        {
                            <div style="font-weight:800;color:var(--gray);">@b.Name</div>
                        }
                    </div>
                    <div style="text-align:center;font-weight:700;font-size:13px;margin-bottom:8px;">@b.Name</div>
                    <div style="display:flex;justify-content:space-between;margin-bottom:10px;font-size:11px;color:var(--gray);">
                        <span>@b.ProductCount محصول</span>
                        <button onclick="toggleActive(@b.Id, this)" data-active="@b.IsActive.ToString().ToLower()"
                                style="border:none;background:none;cursor:pointer;font-size:11px;font-weight:600;
                                               color:@(b.IsActive ? "var(--success)" : "var(--danger)");">
                            @(b.IsActive ? "✓ فعال" : "✗ غیرفعال")
                        </button>
                    </div>
                    <div style="display:flex;gap:6px;">
                        <a asp-action="Edit" asp-route-id="@b.Id" class="btn btn-primary btn-sm" style="flex:1;">
                            <i class="fas fa-edit"></i> ویرایش
                        </a>
                        <button onclick="del(@b.Id, '@b.Name')" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        function toggleActive(id, btn) {
            fetch('/admin/brands/toggleactive/' + id, { method: 'POST',
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() || '' }
            }).then(r => r.json()).then(res => {
                if (res.success) {
                    btn.textContent = res.isActive ? '✓ فعال' : '✗ غیرفعال';
                    btn.style.color = res.isActive ? 'var(--success)' : 'var(--danger)';
                }
            });
        }
        function del(id, name) {
            if (!confirm(`حذف برند «${name}»؟`)) return;
            fetch('/admin/brands/delete/' + id, { method: 'POST',
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() || '' }
            }).then(r => r.json()).then(res => {
                if (res.success) { document.getElementById('card-' + id)?.remove(); showToast(res.message); }
                else showToast(res.message, 'error');
            });
        }
    </script>
}