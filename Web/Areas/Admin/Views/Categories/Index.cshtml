@model List<CategoryListItemDto>
@{ ViewData["Title"] = "مدیریت دسته‌بندی‌ها"; }

<div class="panel">
    <div style="display:flex;justify-content:space-between;margin-bottom:16px;">
        <h2 style="font-size:15px;font-weight:700;">دسته‌بندی‌ها (@Model.Count)</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> دسته جدید</a>
    </div>

    @if (!Model.Any()) { <p style="text-align:center;padding:40px;color:var(--gray);">دسته‌بندی‌ای یافت نشد</p> }
    else
    {
        <table class="admin-table">
            <thead><tr>
                <th>نام</th><th>والد</th><th>محصولات</th><th>ترتیب</th><th>وضعیت</th><th>عملیات</th>
            </tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr id="row-@c.Id">
                        <td style="font-weight:600;">@c.Name</td>
                        <td style="font-size:12px;color:var(--gray);">@(c.ParentName ?? "—")</td>
                        <td>@c.ProductCount</td>
                        <td>@c.DisplayOrder</td>
                        <td>
                            <button onclick="toggleActive(@c.Id, this)" data-active="@c.IsActive.ToString().ToLower()"
                                    style="border:none;background:none;cursor:pointer;font-size:12px;font-weight:600;
                                           color:@(c.IsActive ? "var(--success)" : "var(--danger)");">
                                @(c.IsActive ? "✓ فعال" : "✗ غیرفعال")
                            </button>
                        </td>
                        <td>
                            <div style="display:flex;gap:4px;">
                                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-primary btn-sm"><i class="fas fa-edit"></i></a>
                                <button onclick="del(@c.Id,'@c.Name')" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@section Scripts {
    <script>
        function toggleActive(id, btn) {
            fetch('/admin/categories/toggleactive/' + id, { method: 'POST',
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() || '' }
            }).then(r => r.json()).then(res => {
                if (res.success) {
                    btn.textContent = res.isActive ? '✓ فعال' : '✗ غیرفعال';
                    btn.style.color = res.isActive ? 'var(--success)' : 'var(--danger)';
                }
            });
        }
        function del(id, name) {
            if (!confirm(`حذف «${name}»؟`)) return;
            fetch('/admin/categories/delete/' + id, { method: 'POST',
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() || '' }
            }).then(r => r.json()).then(res => {
                if (res.success) { document.getElementById('row-' + id)?.remove(); showToast(res.message); }
                else showToast(res.message, 'error');
            });
        }
    </script>
}