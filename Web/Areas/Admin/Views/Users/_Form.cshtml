@model dynamic
@{
    var isEdit = (Model as UserEditDto) != null;
    var ue = Model as UserEditDto;
    var uc = Model as UserCreateDto;
    var roles = ViewBag.Roles as List<SelectListItem> ?? new();
    var groups = ViewBag.PermissionGroups as List<PermissionGroupDto> ?? new();
    var selectedIds = ViewBag.SelectedPermissionIds as HashSet<int> ?? new();
}

<div style="display:grid;grid-template-columns:2fr 1fr;gap:20px;">
    <div>
        <div class="panel">
            <div class="panel-title"><i class="fas fa-user"></i> اطلاعات کاربر</div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
                <div>
                    <div class="form-label">نام *</div>
                    @if (isEdit)
                    {
                        <input asp-for="@ue!.FirstName" class="form-control" required />
                    }
                    else
                    {

                        <input asp-for="@uc!.FirstName" class="form-control" required />
                    }
                </div>
                <div>
                    <div class="form-label">نام خانوادگی *</div>
                    @if (isEdit)
                    {
                        <input asp-for="@ue!.LastName" class="form-control" required />
                    }
                    else
                    {

                        <input asp-for="@uc!.LastName" class="form-control" required />
                    }
                </div>
                <div>
                    <div class="form-label">موبایل *</div>
                    @if (isEdit)
                    {
                        <input asp-for="@ue!.PhoneNumber" class="form-control" dir="ltr" required />
                    }
                    else
                    {

                        <input asp-for="@uc!.PhoneNumber" class="form-control" dir="ltr" required />
                    }
                </div>
                <div>
                    <div class="form-label">ایمیل</div>
                    @if (isEdit)
                    {
                        <input asp-for="@ue!.Email" class="form-control" dir="ltr" />
                    }
                    else
                    {

                        <input asp-for="@uc!.Email" class="form-control" dir="ltr" />
                    }
                </div>
            </div>

            @if (!isEdit)
            {
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <div>
                        <div class="form-label">رمز عبور *</div>
                        <input asp-for="@uc!.Password" type="password" class="form-control" required minlength="6" />
                    </div>
                    <div>
                        <div class="form-label">تکرار رمز *</div>
                        <input asp-for="@uc!.ConfirmPassword" type="password" class="form-control" required minlength="6" />
                    </div>
                </div>
            }
            else
            {
                <div style="padding:12px;background:#f8fafc;border-radius:8px;">
                    <div style="font-weight:600;font-size:12px;margin-bottom:8px;">تغییر رمز (اختیاری)</div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                        <input asp-for="@ue!.NewPassword" type="password" placeholder="رمز جدید" class="form-control" />
                        <input asp-for="@ue!.ConfirmNewPassword" type="password" placeholder="تکرار" class="form-control" />
                    </div>
                </div>
            }
        </div>

        <div class="panel">
            <div class="panel-title"><i class="fas fa-user-tag"></i> نقش‌ها</div>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:8px;">
                @foreach (var r in roles)
                {
                    <label style="display:flex;align-items:center;gap:6px;padding:8px;border:1px solid var(--border);border-radius:6px;cursor:pointer;">
                        <input type="checkbox" name="RoleIds" value="@r.Value" checked="@r.Selected" />
                        <span style="font-size:12px;font-weight:600;">@r.Text</span>
                    </label>
                }
            </div>
        </div>
    </div>

    <div>
        <div class="panel">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
                @if (isEdit)
                {
                    <label><input asp-for="@ue!.IsActive" type="checkbox" /> فعال</label>
                }
                else
                {

                    <label><input asp-for="@uc!.IsActive" type="checkbox" /> فعال</label>
                }
            </div>
        </div>

        <div class="panel">
            <div class="panel-title"><i class="fas fa-key"></i> مجوزهای مستقیم</div>
            @foreach (var g in groups)
            {
                <div style="margin-bottom:10px;">
                    <div style="font-weight:700;font-size:11px;margin-bottom:4px;">@g.Group</div>
                    <div style="display:flex;flex-wrap:wrap;gap:4px;">
                        @foreach (var p in g.Permissions)
                        {
                            <label style="font-size:10px;padding:3px 8px;background:var(--light);border-radius:4px;cursor:pointer;">
                                <input type="checkbox" name="DirectPermissionIds" value="@p.Id" checked="@selectedIds.Contains(p.Id)" />
                                @p.Name
                            </label>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="panel">
            <button type="submit" class="btn btn-primary" style="width:100%;height:44px;">
                <i class="fas fa-save"></i> @(isEdit ? "ذخیره" : "ایجاد")
            </button>
            <a asp-action="Index" class="btn btn-outline" style="width:100%;margin-top:8px;text-align:center;">انصراف</a>
        </div>
    </div>
</div>