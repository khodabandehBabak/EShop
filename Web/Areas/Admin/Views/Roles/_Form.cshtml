@model dynamic
@{
    var isEdit = (Model as RoleEditDto) != null;
    var re = Model as RoleEditDto;
    var rc = Model as RoleCreateDto;
    var groups = ViewBag.PermissionGroups as List<PermissionGroupDto> ?? new();
    var selectedSet = ViewBag.SelectedPermissionIds as HashSet<int> ?? new();
}

<div class="panel">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px;">
        <div>
            <div class="form-label">نام نقش *</div>
            @if (isEdit)
            {
                <input asp-for="@re!.Name" class="form-control" dir="ltr" required />
            }
            else
            {

                <input asp-for="@rc!.Name" class="form-control" dir="ltr" required />
            }
        </div>
        <div>
            <div class="form-label">توضیحات</div>
            @if (isEdit)
            {
                <input asp-for="@re!.Description" class="form-control" />
            }
            else
            {

                <input asp-for="@rc!.Description" class="form-control" />
            }
        </div>
    </div>
</div>

<div class="panel">
    <div class="panel-title"><i class="fas fa-key"></i> مجوزها</div>
    @foreach (var g in groups)
    {
        <div style="margin-bottom:12px;">
            <div style="font-weight:700;font-size:12px;margin-bottom:6px;padding-bottom:4px;border-bottom:1px solid var(--border);">
                @g.Group
            </div>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:6px;">
                @foreach (var p in g.Permissions)
                {
                    <label style="display:flex;align-items:center;gap:6px;padding:4px;font-size:12px;cursor:pointer;">
                        <input type="checkbox" name="PermissionIds" value="@p.Id" checked="@selectedSet.Contains(p.Id)" />
                        @p.Name
                    </label>
                }
            </div>
        </div>
    }
</div>

<div class="panel">
    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> @(isEdit ? "ذخیره" : "ایجاد")</button>
    <a asp-action="Index" class="btn btn-outline">انصراف</a>
</div>