@inject EShop.Application.Interfaces.ISettingsService Settings
@{
    var siteName = await Settings.GetAsync(EShop.Domain.Settings.SettingsKeys.SiteName, "ستارخان");
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string name) => currentController == name ? "active" : "";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] | پنل مدیریت @siteName</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <style>
        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #0088cc;
            --primary-dark: #006fa8;
            --success: #00b16b;
            --danger: #e74c3c;
            --warning: #e67e22;
            --purple: #8e44ad;
            --dark: #1e293b;
            --gray: #64748b;
            --light: #f8fafc;
            --border: #e2e8f0;
        }

        body {
            font-family: 'Vazirmatn', Tahoma, sans-serif;
            font-size: 13px;
            line-height: 1.7;
            color: #333;
            background: #f0f2f5;
            direction: rtl;
            min-height: 100vh;
        }

        a {
            color: var(--primary);
            text-decoration: none;
        }

        .admin-wrapper {
            display: flex;
            min-height: 100vh;
        }

        .admin-sidebar {
            width: 260px;
            background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
            color: #fff;
            position: fixed;
            top: 0;
            right: 0;
            bottom: 0;
            overflow-y: auto;
            z-index: 100;
        }

            .admin-sidebar::-webkit-scrollbar {
                width: 4px;
            }

            .admin-sidebar::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,.2);
                border-radius: 2px;
            }

            .admin-sidebar .brand {
                padding: 24px 20px;
                border-bottom: 1px solid rgba(255,255,255,.1);
                display: flex;
                align-items: center;
                gap: 10px;
                font-size: 17px;
                font-weight: 800;
            }

                .admin-sidebar .brand .dot {
                    width: 10px;
                    height: 10px;
                    border-radius: 50%;
                    background: #00b16b;
                }

        .admin-nav {
            list-style: none;
            padding: 16px 0;
        }

            .admin-nav li a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 11px 20px;
                color: #cbd5e1;
                font-weight: 500;
                font-size: 13px;
                transition: all .2s;
                border-right: 3px solid transparent;
            }

                .admin-nav li a:hover {
                    background: rgba(255,255,255,.05);
                    color: #fff;
                }

                .admin-nav li a.active {
                    background: rgba(0,136,204,.15);
                    color: #38bdf8;
                    border-right-color: #38bdf8;
                }

                .admin-nav li a i {
                    width: 20px;
                    text-align: center;
                    font-size: 15px;
                }

            .admin-nav .divider {
                height: 1px;
                background: rgba(255,255,255,.08);
                margin: 12px 20px;
            }

            .admin-nav .badge {
                margin-right: auto;
                background: var(--danger);
                color: #fff;
                padding: 1px 8px;
                border-radius: 10px;
                font-size: 11px;
                font-weight: 600;
            }

        .admin-main {
            margin-right: 260px;
            flex: 1;
            min-height: 100vh;
        }

        .admin-topbar {
            background: #fff;
            padding: 14px 28px;
            box-shadow: 0 2px 8px rgba(0,0,0,.04);
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 50;
        }

            .admin-topbar .page-title {
                font-size: 17px;
                font-weight: 800;
                color: var(--dark);
            }

            .admin-topbar .user-info {
                display: flex;
                align-items: center;
                gap: 16px;
                font-size: 13px;
            }

        .admin-content {
            padding: 24px 28px;
        }

        .panel {
            background: #fff;
            border-radius: 12px;
            padding: 22px;
            box-shadow: 0 2px 8px rgba(0,0,0,.04);
            margin-bottom: 20px;
        }

        .panel-title {
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 16px;
            color: var(--dark);
            display: flex;
            align-items: center;
            gap: 8px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--border);
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 9px 18px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            font-family: inherit;
            font-size: 12px;
            font-weight: 600;
            transition: all .2s;
            text-decoration: none;
        }

        .btn-primary {
            background: var(--primary);
            color: #fff;
        }

            .btn-primary:hover {
                background: var(--primary-dark);
                color: #fff;
            }

        .btn-success {
            background: var(--success);
            color: #fff;
        }

        .btn-danger {
            background: var(--danger);
            color: #fff;
        }

        .btn-warning {
            background: var(--warning);
            color: #fff;
        }

        .btn-outline {
            background: #fff;
            color: #333;
            border: 1px solid var(--border);
        }

        .btn-sm {
            padding: 6px 12px;
            font-size: 11px;
        }

        .form-control, .form-select {
            width: 100%;
            padding: 9px 13px;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-family: inherit;
            font-size: 13px;
            transition: all .2s;
            background: #fff;
        }

            .form-control:focus, .form-select:focus {
                outline: none;
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(0,136,204,.1);
            }

        .form-label {
            display: block;
            font-weight: 600;
            font-size: 12px;
            margin-bottom: 6px;
            color: var(--dark);
        }

        .admin-table {
            width: 100%;
            border-collapse: collapse;
        }

            .admin-table thead th {
                text-align: right;
                padding: 12px;
                font-size: 12px;
                font-weight: 600;
                color: var(--gray);
                background: var(--light);
                border-bottom: 1px solid var(--border);
            }

            .admin-table tbody td {
                padding: 12px;
                font-size: 13px;
                border-bottom: 1px solid #f1f5f9;
            }

            .admin-table tbody tr:hover {
                background: #f8fafc;
            }

        .alert {
            padding: 13px 18px;
            border-radius: 10px;
            margin-bottom: 16px;
            font-size: 13px;
        }

        .alert-success {
            background: #e8f8f0;
            color: #047857;
        }

        .alert-danger {
            background: #fdeaea;
            color: #991b1b;
        }

        .alert-info {
            background: #e6f4ff;
            color: #0369a1;
        }

        .status-badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 10px;
            font-size: 11px;
            font-weight: 600;
        }

        .status-pending {
            background: #fff3e0;
            color: #e67e22;
        }

        .status-paid {
            background: #e8f8f0;
            color: #00b16b;
        }

        .status-processing {
            background: #e6f4ff;
            color: #0088cc;
        }

        .status-packed {
            background: #f3e8ff;
            color: #8e44ad;
        }

        .status-shipped {
            background: #e0f2fe;
            color: #3498db;
        }

        .status-delivered {
            background: #e8f8f0;
            color: #00b16b;
        }

        .status-cancelled {
            background: #fdeaea;
            color: #e74c3c;
        }

        .toast {
            position: fixed;
            top: 20px;
            left: 20px;
            z-index: 9999;
            background: #fff;
            padding: 14px 20px;
            border-radius: 10px;
            box-shadow: 0 8px 24px rgba(0,0,0,.15);
            font-size: 13px;
            font-weight: 600;
            color: #333;
            max-width: 400px;
            animation: slideIn .3s;
        }

            .toast.success {
                border-right: 4px solid var(--success);
            }

            .toast.error {
                border-right: 4px solid var(--danger);
            }

        @@keyframes slideIn {
            from {
                transform: translateX(-100%);
                opacity: 0;
            }

            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        @@media (max-width: 991px) {
            .admin-sidebar {
                transform: translateX(100%);
                transition: transform .3s;
            }

                .admin-sidebar.open {
                    transform: translateX(0);
                }

            .admin-main {
                margin-right: 0;
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="admin-wrapper">
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="brand">
                <span class="dot"></span>
                <span>@siteName</span>
            </div>
            <ul class="admin-nav">
                <li>
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="@Active("Dashboard")">
                        <i class="fas fa-tachometer-alt"></i> داشبورد
                    </a>
                </li>

                <li>
                    <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="@Active("Orders")">
                        <i class="fas fa-shopping-bag"></i> سفارشات
                        <span class="badge" id="pendingOrdersBadge" style="display:none;">0</span>
                    </a>
                </li>

                <div class="divider"></div>

                <li>
                    <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="@Active("Products")">
                        <i class="fas fa-cube"></i> محصولات
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="@Active("Categories")">
                        <i class="fas fa-list"></i> دسته‌بندی‌ها
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Brands" asp-action="Index" class="@Active("Brands")">
                        <i class="fas fa-tags"></i> برندها
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Attributes" asp-action="Index" class="@Active("Attributes")">
                        <i class="fas fa-sliders-h"></i> ویژگی‌ها
                    </a>
                </li>

                <div class="divider"></div>

                <li>
                    <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="@Active("Users")">
                        <i class="fas fa-users"></i> کاربران
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Roles" asp-action="Index" class="@Active("Roles")">
                        <i class="fas fa-user-shield"></i> نقش‌ها
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Permissions" asp-action="Index" class="@Active("Permissions")">
                        <i class="fas fa-key"></i> مجوزها
                    </a>
                </li>

                <div class="divider"></div>

                <li>
                    <a asp-area="Admin" asp-controller="Sliders" asp-action="Index" class="@Active("Sliders")">
                        <i class="fas fa-images"></i> اسلایدرها
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Reviews" asp-action="Index" class="@Active("Reviews")">
                        <i class="fas fa-comments"></i> نظرات
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Reports" asp-action="Index" class="@Active("Reports")">
                        <i class="fas fa-chart-line"></i> گزارشات
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Settings" asp-action="Index" class="@Active("Settings")">
                        <i class="fas fa-cog"></i> تنظیمات
                    </a>
                </li>

                <div class="divider"></div>

                <li><a href="/" target="_blank"><i class="fas fa-external-link-alt"></i> مشاهده فروشگاه</a></li>
            </ul>
        </aside>

        <div class="admin-main">
            <div class="admin-topbar">
                <div style="display:flex;align-items:center;gap:16px;">
                    <button onclick="document.getElementById('adminSidebar').classList.toggle('open')"
                            style="display:none;background:none;border:none;font-size:20px;cursor:pointer;"
                            class="d-lg-none">
                        ☰
                    </button>
                    <h1 class="page-title">@ViewData["Title"]</h1>
                </div>
                <div class="user-info">
                    <span style="color:var(--gray);">@User.Identity?.Name</span>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                        @Html.AntiForgeryToken()
                        <button type="submit" style="background:none;border:none;color:var(--danger);
                                font-weight:600;cursor:pointer;font-size:12px;">
                            <i class="fas fa-sign-out-alt"></i> خروج
                        </button>
                    </form>
                </div>
            </div>

            <div class="admin-content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">
                        <i class="fas fa-check-circle"></i> @TempData["Success"]
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-triangle"></i> @TempData["Error"]
                    </div>
                }

                @RenderBody()
            </div>
        </div>
    </div>

    <div id="toastContainer"></div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        function showToast(msg, type) {
            type = type || 'success';
            const div = document.createElement('div');
            div.className = 'toast ' + type;
            div.textContent = msg;
            document.getElementById('toastContainer').appendChild(div);
            setTimeout(() => div.remove(), 4000);
        }

        // SignalR برای سفارشات جدید
        const orderConn = new signalR.HubConnectionBuilder()
            .withUrl("/orderHub")
            .withAutomaticReconnect()
            .build();

        orderConn.on("OrderUpdated", function () {
            updatePendingBadge();
        });

        orderConn.start().catch(err => console.log('SignalR:', err));

        function updatePendingBadge() {
            fetch('/admin/orders/pendingcount')
                .then(r => r.json())
                .then(count => {
                    const b = document.getElementById('pendingOrdersBadge');
                    if (b) {
                        if (count > 0) { b.textContent = count; b.style.display = 'inline-block'; }
                        else b.style.display = 'none';
                    }
                })
                .catch(() => {});
        }
        updatePendingBadge();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>