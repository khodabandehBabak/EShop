@model List<ReviewAdminListDto>
@{
    ViewData["Title"] = "مدیریت نظرات";
    var filter = ViewBag.Filter as ReviewFilterDto ?? new();
    var totalPages = (int)ViewBag.TotalPages;
}

<div class="panel">
    <form method="get" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;">
        <input name="search" value="@filter.Search" placeholder="جستجو در نام یا متن..."
               class="form-control" style="flex:1;min-width:200px;" />

        <select name="isApproved" class="form-select" style="min-width:140px;">
            <option value="">همه وضعیت</option>
            <option value="false" selected="@(filter.IsApproved == false)">در انتظار تأیید</option>
            <option value="true" selected="@(filter.IsApproved == true)">تأیید شده</option>
        </select>

        <select name="minRating" class="form-select" style="min-width:130px;">
            <option value="">حداقل امتیاز</option>
            @for (int i = 1; i <= 5; i++)
            {
                <option value="@i" selected="@(filter.MinRating == i)">@i ستاره</option>
            }
        </select>

        <button type="submit" class="btn btn-primary">
            <i class="fas fa-search"></i> جستجو
        </button>
    </form>

    <div class="panel-title">
        <i class="fas fa-comments"></i> نظرات (@ViewBag.Total)
    </div>

    @if (!Model.Any())
    {
        <div style="text-align:center;padding:50px;color:var(--gray);">
            <i class="fas fa-comments" style="font-size:60px;opacity:.3;"></i>
            <p style="margin-top:12px;">نظری یافت نشد</p>
        </div>
    }
    else
    {
        foreach (var r in Model)
        {
            <div class="review-card" id="card-@r.Id"
                 style="border:1px solid var(--border);border-radius:12px;padding:16px;
                                margin-bottom:12px;background:#fff;
                                border-right:4px solid @(r.IsApproved ? "var(--success)" : "var(--warning)");">

                <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px;flex-wrap:wrap;gap:8px;">
                    <div>
                        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                            <strong style="font-size:14px;">@r.UserFullName</strong>
                            @if (!string.IsNullOrEmpty(r.UserPhone))
                            {
                                <span style="font-size:11px;color:var(--gray);" dir="ltr">@r.UserPhone</span>
                            }
                            @if (r.IsVerifiedPurchase)
                            {
                                <span style="background:#e8f8f0;color:var(--success);
                                                         padding:2px 8px;border-radius:8px;
                                                         font-size:10px;font-weight:700;">
                                    <i class="fas fa-check"></i> خرید تأییدشده
                                </span>
                            }
                            @if (r.IsApproved)
                            {
                                <span class="status-badge status-delivered">تأیید شده</span>
                            }
                            else
                            {
                                <span class="status-badge status-pending">در انتظار</span>
                            }
                        </div>
                        <div style="font-size:11px;color:var(--gray);margin-top:4px;">
                            روی محصول:
                            <a href="/product/@r.ProductSlug" target="_blank"
                               style="color:var(--primary);font-weight:600;text-decoration:none;">
                                @r.ProductName
                            </a>
                        </div>
                    </div>
                    <div style="color:#ffc107;font-size:14px;">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <i class="fas fa-star" style="opacity:@(i <= r.Rating ? 1 : .2);"></i>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(r.Title))
                {
                    <h5 style="font-size:13px;font-weight:700;margin-bottom:6px;">@r.Title</h5>
                }
                @if (!string.IsNullOrEmpty(r.Comment))
                {
                    <p style="font-size:13px;line-height:1.8;color:#475569;margin-bottom:12px;">@r.Comment</p>
                }

                <div style="display:flex;gap:6px;flex-wrap:wrap;padding-top:10px;border-top:1px dashed var(--border);">
                    @if (!r.IsApproved)
                    {
                        <button onclick="approve(@r.Id)" class="btn btn-success btn-sm">
                            <i class="fas fa-check"></i> تأیید
                        </button>
                        <button onclick="reject(@r.Id)" class="btn btn-warning btn-sm">
                            <i class="fas fa-times-circle"></i> رد
                        </button>
                    }
                    <button onclick="del(@r.Id)" class="btn btn-danger btn-sm">
                        <i class="fas fa-trash"></i> حذف
                    </button>
                    <span style="font-size:11px;color:var(--gray);margin-right:auto;align-self:center;">
                        @r.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                    </span>
                </div>
            </div>
        }

        @if (totalPages > 1)
        {
            <div style="display:flex;justify-content:center;gap:6px;margin-top:20px;">
                @for (int i = 1; i <= totalPages; i++)
                {
                    <a href="?page=@i&isApproved=@filter.IsApproved&search=@filter.Search&minRating=@filter.MinRating"
                       style="padding:6px 12px;border-radius:6px;text-decoration:none;
                                          font-weight:600;font-size:12px;
                                          background:@(i == filter.Page ? "var(--primary)" : "var(--light)");
                                          color:@(i == filter.Page ? "#fff" : "#333");">
                        @i
                    </a>
                }
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        function token() { return $('input[name="__RequestVerificationToken"]').val() || ''; }

        async function approve(id) {
            const fd = new FormData();
            fd.append('id', id);
            fd.append('__RequestVerificationToken', token());
            const res = await fetch('/admin/reviews/approve', { method: 'POST', body: fd }).then(r => r.json());
            if (res.success) {
                showToast(res.message);
                setTimeout(() => location.reload(), 500);
            } else showToast(res.message, 'error');
        }

        async function reject(id) {
            const reason = prompt('دلیل رد (اختیاری):') || '';
            const fd = new FormData();
            fd.append('id', id);
            fd.append('reason', reason);
            fd.append('__RequestVerificationToken', token());
            const res = await fetch('/admin/reviews/reject', { method: 'POST', body: fd }).then(r => r.json());
            if (res.success) {
                showToast(res.message);
                setTimeout(() => location.reload(), 500);
            } else showToast(res.message, 'error');
        }

        async function del(id) {
            if (!confirm('حذف این نظر؟')) return;
            const fd = new FormData();
            fd.append('id', id);
            fd.append('__RequestVerificationToken', token());
            const res = await fetch('/admin/reviews/delete', { method: 'POST', body: fd }).then(r => r.json());
            if (res.success) {
                document.getElementById('card-' + id)?.remove();
                showToast(res.message);
            }
        }
    </script>
}