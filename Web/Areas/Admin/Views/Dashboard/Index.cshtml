@using System.Text.Json
@model List<Order>
@{
    ViewData["Title"] = "داشبورد";
    var topViewed = ViewBag.TopViewedProducts as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin-bottom:20px;">
    <div class="panel" style="margin:0;">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;">
            <div>
                <div style="font-size:12px;color:var(--gray);">سفارشات امروز</div>
                <div style="font-size:24px;font-weight:800;color:var(--dark);margin-top:4px;">
                    @ViewBag.TodayOrders
                </div>
            </div>
            <div style="width:44px;height:44px;background:#e6f4ff;color:var(--primary);
                        border-radius:10px;display:flex;align-items:center;justify-content:center;">
                <i class="fas fa-shopping-bag"></i>
            </div>
        </div>
    </div>

    <div class="panel" style="margin:0;">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;">
            <div>
                <div style="font-size:12px;color:var(--gray);">درآمد امروز</div>
                <div style="font-size:18px;font-weight:800;color:var(--success);margin-top:4px;">
                    @(((decimal)ViewBag.TodayRevenue).ToString("N0"))
                </div>
            </div>
            <div style="width:44px;height:44px;background:#e8f8f0;color:var(--success);
                        border-radius:10px;display:flex;align-items:center;justify-content:center;">
                <i class="fas fa-money-bill"></i>
            </div>
        </div>
    </div>

    <div class="panel" style="margin:0;">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;">
            <div>
                <div style="font-size:12px;color:var(--gray);">در انتظار</div>
                <div style="font-size:24px;font-weight:800;color:var(--warning);margin-top:4px;">
                    @ViewBag.PendingOrders
                </div>
            </div>
            <div style="width:44px;height:44px;background:#fff3e0;color:var(--warning);
                        border-radius:10px;display:flex;align-items:center;justify-content:center;">
                <i class="fas fa-clock"></i>
            </div>
        </div>
    </div>

    <div class="panel" style="margin:0;">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;">
            <div>
                <div style="font-size:12px;color:var(--gray);">کل کاربران</div>
                <div style="font-size:24px;font-weight:800;color:var(--purple);margin-top:4px;">
                    @ViewBag.TotalCustomers
                </div>
            </div>
            <div style="width:44px;height:44px;background:#f3e8ff;color:var(--purple);
                        border-radius:10px;display:flex;align-items:center;justify-content:center;">
                <i class="fas fa-users"></i>
            </div>
        </div>
    </div>
</div>

<div style="display:grid;grid-template-columns:2fr 1fr;gap:16px;margin-bottom:20px;">
    <div class="panel">
        <div class="panel-title">
            <i class="fas fa-chart-line" style="color:var(--success);"></i>
            درآمد ۷ روز گذشته
        </div>
        <canvas id="weekChart" style="max-height:280px;"></canvas>
    </div>

    <div class="panel">
        <div class="panel-title">
            <i class="fas fa-eye" style="color:var(--primary);"></i>
            پربازدیدترین محصولات
        </div>
        @if (!topViewed.Any())
        {
            <p style="color:var(--gray);text-align:center;padding:30px;">آماری موجود نیست</p>
        }
        else
        {
            foreach (var p in topViewed)
            {
                <div style="display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--border);">
                    <div style="width:44px;height:44px;background:var(--light);border-radius:8px;overflow:hidden;flex-shrink:0;">
                        @if (p.ImageUrl != null)
                        {
                            <img src="@p.ImageUrl" style="width:100%;height:100%;object-fit:cover;" />
                        }
                    </div>
                    <div style="flex:1;min-width:0;">
                        <a href="/product/@p.Slug" target="_blank"
                           style="font-weight:600;font-size:12px;color:var(--dark);
                                          display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                            @p.Name
                        </a>
                    </div>
                    <span style="background:#e6f4ff;color:var(--primary);padding:3px 8px;
                                         border-radius:8px;font-size:11px;font-weight:700;">
                        @(((int)p.ViewCount).ToString("N0"))
                    </span>
                </div>
            }
        }
    </div>
</div>

<div class="panel">
    <div class="panel-title">
        <i class="fas fa-clock" style="color:var(--primary);"></i>
        آخرین سفارشات
    </div>
    @if (!Model.Any())
    {
        <p style="color:var(--gray);text-align:center;padding:30px;">سفارشی موجود نیست</p>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>شماره</th>
                        <th>مشتری</th>
                        <th>مبلغ</th>
                        <th>وضعیت</th>
                        <th>تاریخ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model)
                    {
                        <tr>
                            <td style="font-weight:700;color:var(--primary);">@o.OrderNumber</td>
                            <td>@o.ReceiverName</td>
                            <td style="color:var(--success);font-weight:600;">
                                @o.TotalAmount.ToString("N0")
                            </td>
                            <td>
                                <span class="status-badge status-@o.Status.ToString().ToLower()">
                                    @GetStatusLabel(o.Status)
                                </span>
                            </td>
                            <td style="font-size:11px;color:var(--gray);">
                                @o.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        Chart.defaults.font.family = 'Vazirmatn, Tahoma, sans-serif';
        const weekData = @Html.Raw(JsonSerializer.Serialize(ViewBag.WeekChart));

        new Chart(document.getElementById('weekChart'), {
            type: 'line',
            data: {
                labels: weekData.map(d => d.day),
                datasets: [{
                    label: 'درآمد (تومان)',
                    data: weekData.map(d => d.amount),
                    borderColor: '#0088cc',
                    backgroundColor: 'rgba(0,136,204,0.1)',
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true,
                        ticks: { callback: v => v >= 1000 ? (v/1000).toFixed(0) + 'K' : v }
                    }
                }
            }
        });
    </script>
}

@functions {
    string GetStatusLabel(OrderStatus s) => s switch
    {
        OrderStatus.Pending => "در انتظار",
        OrderStatus.Paid => "پرداخت شده",
        OrderStatus.Processing => "در پردازش",
        OrderStatus.Packed => "بسته‌بندی",
        OrderStatus.Shipped => "ارسال شده",
        OrderStatus.Delivered => "تحویل",
        OrderStatus.Cancelled => "لغو شده",
        _ => s.ToString()
    };
}